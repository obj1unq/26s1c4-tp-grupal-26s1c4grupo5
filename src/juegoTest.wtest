import wollok.game.*
import juego.*
import mapas.*
import mapa1.*
import mapa3.*
import pak-man.*
import objetos.*

describe "Obstaculos" {
  test "colisionar con moneda suma 10 puntos" {
    const moneda = new Moneda()
    moneda.colisionar(pak)
    assert.equals(10, pak.puntos())
  }
  
  test "puede pasar al siguiente mapa" {  
    juego.siguienteMapa()
    assert.equals(mapa1, juego.mapaActual())
  }
  
}